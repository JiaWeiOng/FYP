# Copy this file to ".env.local" and fill in the values.
# These are the SAME public Firebase config values the mobile app uses
# (Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK config).
# The config is PUBLIC (not a secret) — access is controlled by Auth + Firestore rules.
# Do NOT put the Google Safe Browsing key here; the admin site does not need it.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

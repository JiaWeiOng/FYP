# Copy this file to ".env.local" and fill in the values.
# ".env.local" is git-ignored and must NOT be included when the source is handed over.

# --- Google Safe Browsing (SECRET) -------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> API key
# Enable "Safe Browsing API" for the key and restrict it to that API.
# Free of charge (default quota 10,000 requests/day).
EXPO_PUBLIC_GSB_API_KEY=

# --- Firebase client config (public, not secret) ------------------------------
# Firebase Console -> Project settings -> General -> Your apps -> SDK config.
# These values ship inside the APK by design; access is controlled by
# Firebase Authentication and the Firestore security rules, not by hiding them.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
